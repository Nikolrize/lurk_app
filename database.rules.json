{
    "rules": {
        ".read": false,
        ".write": false,
        "presence": {
        "$uid": {
            ".read": "auth != null",
            "preference": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.isString() && (newData.val() === 'online' || newData.val() === 'idle' || newData.val() === 'do_not_disturb' || newData.val() === 'offline')"
            },
            "sessions": {
            "$sessionId": {
                ".write": "auth != null && auth.uid === $uid && $sessionId.length <= 100",
                ".validate": "newData.isString() && (newData.val() === 'online' || newData.val() === 'idle')"
            }
            }
        }
        }
    }
}
