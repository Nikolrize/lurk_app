rules_version = '2';

// players/{uid}:
// username, bio, region: required strings.
// createdAt: immutable timestamp; updatedAt: server timestamp.
//
// player_private/{uid}:
// dateOfBirth: required nullable timestamp.
// gender: required string from the allowed values.
// createdAt: immutable timestamp; updatedAt: server timestamp.
//
// document IDs are firebase auth UIDs
// unmactched paths are denied


// optional public sharing
// sharedAge: nullable integer, 0 - 150 
// ageSharedAt: nullable timestamp, required with a shared age
//sharedGender : nullable male/female/other
//full birth date remains in player_private

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function owns(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function validSharing(data) {
      let age = data.get('sharedAge', null);
      let sharedAt = data.get('ageSharedAt', null);
      let gender = data.get('sharedGender', null);

      return (
        (age == null && sharedAt == null)
        || (
          age is int
          && age >= 0
          && age <= 150
          && sharedAt is timestamp
          && sharedAt <= request.time
        )
      )
      && (
        gender == null
        || gender in ['male', 'female', 'other']
      );
    }


    function validGamingPreferences(data) {
      let games = data.get('games', []);
      let game = data.get('currentGame', null);
      let mode = data.get('mode', null);
      let styles = data.get('playstyles', []);
      let communication = data.get('communication', null);
      let rank = data.get('rank', null);

      return games is list
        && games.size() <= 3
        && games.toSet().size() == games.size()
        && games.hasOnly([
          'valorant', 'mobile_legends', 'fortnite'
        ])
        && (
          (game == null && games.size() == 0)
          || (game is string && game in games)
        )
        && (
          mode == null
          || mode in ['competitive', 'casual']
        )
        && styles is list
        && styles.size() <= 3
        && styles.toSet().size() == styles.size()
        && styles.hasOnly(['chill', 'serious', 'fun'])
        && (
          communication == null
          || communication in [
            'mic_required', 'voice_optional', 'chat_only'
          ]
        )
        && (
          rank == null
          || (
            game == 'valorant'
            && rank is int
            && rank >= 0
            && rank <= 7
          )
        );
    }
    function validPublicProfile(data) {
      return data.keys().hasAll([
          'username', 'bio', 'region', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'username', 'bio', 'region', 'createdAt', 'updatedAt',
          'sharedAge', 'ageSharedAt', 'sharedGender',
          'games', 'currentGame', 'mode', 'playstyles',
          'communication', 'rank'
        ])
        && data.username is string
        && (
          data.username.size() == 0
          || data.username.size() >= 3
        )
        && data.username.size() <= 30
        && data.bio is string
        && data.bio.size() <= 500
        && data.region is string
        && data.region.size() <= 60
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && validSharing(data)
        && validGamingPreferences(data);
    }

    function validPrivateInfo(data) {
      return data.keys().hasAll([
          'dateOfBirth', 'gender', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'dateOfBirth', 'gender', 'createdAt', 'updatedAt'
        ])
        && (
          data.dateOfBirth == null
          || (
            data.dateOfBirth is timestamp
            && data.dateOfBirth >= timestamp.date(1900, 1, 1)
            && data.dateOfBirth <= request.time
          )
        )
        && data.gender is string
        && data.gender in [
          '', 'male', 'female', 'other', 'prefer_not_to_say'
        ]
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Initial party integration: discovery reads only. Writes remain blocked.
    match /parties/{partyId} {
      allow read: if signedIn()
        && resource.data.visibility == 'public'
        && resource.data.status == 'open';
      allow write: if false;
    }
    match /players/{uid} {
      allow read: if signedIn();

      allow create: if owns(uid)
        && validPublicProfile(request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if owns(uid)
        && validPublicProfile(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly([
          'username', 'bio', 'region', 'updatedAt',
          'sharedAge', 'ageSharedAt', 'sharedGender',
          'games', 'currentGame', 'mode', 'playstyles',
          'communication', 'rank'
        ])
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;
    }

    match /player_private/{uid} {
      allow read: if owns(uid);

      allow create: if owns(uid)
        && validPrivateInfo(request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if owns(uid)
        && validPrivateInfo(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['dateOfBirth', 'gender', 'updatedAt'])
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;
    }
  }
}