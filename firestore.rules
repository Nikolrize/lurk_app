rules_version = '2';

// players/{uid}:
// username, bio, region: required strings.
// createdAt: immutable timestamp; updatedAt: server timestamp.
//
// player_private/{uid}:
// dateOfBirth: required nullable timestamp.
// gender: required string from the allowed values.
// createdAt: immutable timestamp; updatedAt: server timestamp.
//
// document IDs are firebase auth UIDs
// unmactched paths are denied


// optional public sharing
// sharedAge: nullable integer, 0 - 150 
// ageSharedAt: nullable timestamp, required with a shared age
//sharedGender : nullable male/female/other
//full birth date remains in player_private

service cloud.firestore {
  match /databases/{database}/documents {
    match /notification_preferences/{uid} {
      allow read: if owns(uid);
      allow create, update: if owns(uid)
        && request.resource.data.keys().hasOnly(['messages', 'invitations'])
        && request.resource.data.messages is bool
        && request.resource.data.invitations is bool;
      allow delete: if false;
    }
    // Tokens are private to their account. Sending is reserved for the Admin SDK.
    match /notification_users/{uid}/devices/{deviceId} {
      allow read, delete: if owns(uid);
      allow create, update: if owns(uid)
        && request.resource.data.keys().hasOnly(['token', 'platform', 'updatedAt'])
        && request.resource.data.token is string
        && request.resource.data.token == deviceId
        && deviceId.size() >= 20 && deviceId.size() <= 2048
        && request.resource.data.platform == 'android'
        && request.resource.data.updatedAt == request.time;
    }
    function signedIn() {
      return request.auth != null;
    }

    function owns(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    //verification
    //admin membership managed through firebase console
    //requests contain private ID details, public status contains no ID detials
    function isVerificationAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/verification_admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/verification_admins/$(request.auth.uid)).data.get('enabled', false) == true;
    }

    function verificationText(value, minimum, maximum) {
      return value is string
        && value.size() >= minimum
        && value.size() <= maximum
        && value.matches('[\\s\\S]*[^\\s][\\s\\S]*');
    }

    match /verification_admins/{uid} {
      allow get: if owns(uid);
      allow list, create, update, delete: if false;
    }

    match /verification_requests/{uid} {
      function validVerificationRequest(data) {
        let fields = [
          'submissionId', 'fullName', 'idType', 'idNumber',
          'dateOfBirth', 'idPhotoPath', 'confirmed', 'status',
          'submittedAt', 'reviewedAt', 'reviewedBy', 'rejectionReason'
        ];
        let photo = data.get('idPhotoPath', '');
        let parts = photo is string ? photo.split('/') : [];

        return data.keys().hasAll(fields)
          && data.keys().hasOnly(fields)
          && data.submissionId is string
          && data.submissionId.matches('^[a-f0-9-]{36}$')
          && verificationText(data.fullName, 2, 100)
          && data.idType in ['nric', 'passport']
          && verificationText(data.idNumber, 4, 40)
          && data.dateOfBirth is timestamp
          && data.dateOfBirth >= timestamp.date(1900, 1, 1)
          && data.dateOfBirth <= request.time
          && photo is string && photo.size() <= 200
          && parts.size() == 3
          && parts[0] == uid
          && parts[1] == data.submissionId
          && parts[2].matches('^id[.](jpg|png|webp)$')
          && data.confirmed == true
          && data.submittedAt is timestamp
          && data.submittedAt <= request.time
          && data.rejectionReason is string
          && data.rejectionReason.size() <= 300
          && (
            (data.status == 'pending'
              && data.reviewedAt == null
              && data.reviewedBy == null
              && data.rejectionReason == '')
            || (data.status in ['verified', 'rejected']
              && data.reviewedAt is timestamp
              && data.reviewedAt >= data.submittedAt
              && data.reviewedAt <= request.time
              && data.reviewedBy is string
              && data.reviewedBy.size() > 0
              && data.reviewedBy.size() <= 128
              && (
                (data.status == 'verified' && data.rejectionReason == '')
                || (data.status == 'rejected'
                  && verificationText(data.rejectionReason, 3, 300))
              ))
          );
      }

      function matchingPublicStatus(status) {
        let summary = getAfter(/databases/$(database)/documents/verification_status/$(uid)).data;
        return summary.status == status && summary.updatedAt == request.time;
      }

      function validNewSubmission(data) {
        return owns(uid)
          && validVerificationRequest(data)
          && data.status == 'pending'
          && data.submittedAt == request.time
          && matchingPublicStatus('pending');
      }

      function validAdminReview(data) {
        return isVerificationAdmin()
          && request.auth.uid != uid
          && resource.data.status == 'pending'
          && validVerificationRequest(data)
          && data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'reviewedAt', 'reviewedBy', 'rejectionReason'
          ])
          && data.status in ['verified', 'rejected']
          && data.reviewedBy == request.auth.uid
          && data.reviewedAt == request.time
          && matchingPublicStatus(data.status);
      }

      allow get: if owns(uid) || isVerificationAdmin();
      allow list: if isVerificationAdmin()
        && request.query.limit != null
        && request.query.limit <= 100;
      allow create: if validNewSubmission(request.resource.data);
      allow update: if (
          resource.data.status == 'rejected'
          && request.resource.data.submissionId != resource.data.submissionId
          && validNewSubmission(request.resource.data)
        ) || validAdminReview(request.resource.data);
      allow delete: if false;
    }

    match /verification_status/{uid} {
      function validVerificationSummary(data) {
        return data.keys().hasAll(['status', 'updatedAt'])
          && data.keys().hasOnly(['status', 'updatedAt'])
          && data.status in ['pending', 'verified', 'rejected']
          && data.updatedAt is timestamp
          && data.updatedAt == request.time;
      }

      function matchingPrivateRequest(data) {
        let submission = getAfter(/databases/$(database)/documents/verification_requests/$(uid)).data;
        return submission.status == data.status && (
          (owns(uid) && data.status == 'pending'
            && submission.submittedAt == request.time)
          || (isVerificationAdmin() && request.auth.uid != uid
            && data.status in ['verified', 'rejected']
            && submission.reviewedBy == request.auth.uid
            && submission.reviewedAt == request.time)
        );
      }

      allow read: if signedIn();
      allow create, update: if signedIn()
        && validVerificationSummary(request.resource.data)
        && matchingPrivateRequest(request.resource.data);
      allow delete: if false;
    }



    function unblocked(users) {
      return !exists(/databases/$(database)/documents/player_blocks/$(users[0])/users/$(users[1]))
        && !exists(/databases/$(database)/documents/player_blocks/$(users[1])/users/$(users[0]))
        && !exists(/databases/$(database)/documents/player_blocks/$(users[0])/blocked/$(users[1]))
        && !exists(/databases/$(database)/documents/player_blocks/$(users[1])/blocked/$(users[0]));
    }

    match /player_blocks/{uid}/users/{otherUid} {
      allow get: if signedIn() && request.auth.uid in [uid, otherUid];
      allow list: if owns(uid);
      allow create: if owns(uid) && uid != otherUid
        && request.resource.data.keys().hasOnly(['createdAt'])
        && request.resource.data.createdAt == request.time
        && exists(/databases/$(database)/documents/players/$(otherUid));
      allow delete: if owns(uid);
      allow update: if false;
    }

    function validSharing(data) {
      let age = data.get('sharedAge', null);
      let sharedAt = data.get('ageSharedAt', null);
      let gender = data.get('sharedGender', null);

      return (
        (age == null && sharedAt == null)
        || (
          age is int
          && age >= 0
          && age <= 150
          && sharedAt is timestamp
          && sharedAt <= request.time
        )
      )
      && (
        gender == null
        || gender in ['male', 'female', 'other']
      );
    }

    // Supported game IDs and rank positions mirror GameCatalog.
    // Public gameRanks maps only contain selected ranked games (maximum six).
    function catalogueGames() {
      return [
        'valorant', 'mobile_legends', 'fortnite', 'apex_legends', 'cs2',
        'honor_of_kings', 'league_of_legends', 'minecraft', 'roblox', 'peak'
      ];
    }
    function catalogueRankNumbers(game) {
      // Select one map so validation stays below the rules expression limit.
      return game == 'valorant' ? {
          'iron': 0,
          'bronze': 1,
          'silver': 2,
          'gold': 3,
          'platinum': 4,
          'diamond': 5,
          'ascendant': 6,
          'immortal': 7,
          'radiant': 8
        } :
        game == 'mobile_legends' ? {
          'warrior': 0,
          'elite': 1,
          'master': 2,
          'grandmaster': 3,
          'epic': 4,
          'legend': 5,
          'mythic': 6,
          'mythical_honor': 7,
          'mythical_glory': 8,
          'mythical_immortal': 9
        } :
        game == 'apex_legends' ? {
          'rookie': 0,
          'bronze': 1,
          'silver': 2,
          'gold': 3,
          'platinum': 4,
          'diamond': 5,
          'master': 6,
          'apex_predator': 7
        } :
        game == 'cs2' ? {
          'silver_1': 0,
          'silver_2': 1,
          'silver_3': 2,
          'silver_4': 3,
          'silver_elite': 4,
          'silver_elite_master': 5,
          'gold_nova_1': 6,
          'gold_nova_2': 7,
          'gold_nova_3': 8,
          'gold_nova_master': 9,
          'master_guardian_1': 10,
          'master_guardian_2': 11,
          'master_guardian_elite': 12,
          'distinguished_master_guardian': 13,
          'legendary_eagle': 14,
          'legendary_eagle_master': 15,
          'supreme_master_first_class': 16,
          'global_elite': 17
        } :
        game == 'honor_of_kings' ? {
          'bronze': 0,
          'silver': 1,
          'gold': 2,
          'platinum': 3,
          'diamond': 4,
          'master': 5,
          'grandmaster': 6,
          'mythic': 7,
          'epic': 8,
          'legend': 9
        } :
        game == 'league_of_legends' ? {
          'iron': 0,
          'bronze': 1,
          'silver': 2,
          'gold': 3,
          'platinum': 4,
          'emerald': 5,
          'diamond': 6,
          'master': 7,
          'grandmaster': 8,
          'challenger': 9
        } : {};
    }
    function catalogueRankCount(game) {
      return catalogueRankNumbers(game).size();
    }
    //rank number same as game's catalogue position
    function rankNumber(game, rankId) {
      return rankId == null ? null : catalogueRankNumbers(game).get(rankId, null);
    }

    //gameRanks - optional public map
    // only selected, supported ranked games have entries
    //each entry must contain valid rank ID
    function validStoredGameRanks(data) {
      let ranks = data.get('gameRanks', {});
      let games = data.get('games', []);
      let game = data.get('currentGame', null);
      let chosenRank = ranks is map && game is string
        ? ranks.get(game, null)
        : null;

      return ranks is map
        && ranks.keys().size() <= 6
        && ranks.keys().hasOnly([
          'valorant', 'mobile_legends', 'apex_legends', 'cs2',
          'honor_of_kings', 'league_of_legends'
        ])
        && ranks.keys().hasOnly(games)
        && (
          !('valorant' in ranks)
          || ranks.valorant in [
            'iron', 'bronze', 'silver', 'gold', 'platinum',
            'diamond', 'ascendant', 'immortal', 'radiant'
          ]
        )
        && (
          !('mobile_legends' in ranks)
          || ranks.mobile_legends in [
            'warrior', 'elite', 'master', 'grandmaster',
            'epic', 'legend', 'mythic', 'mythical_honor',
            'mythical_glory', 'mythical_immortal'
          ]
        )
        && (!('apex_legends' in ranks)
          || ranks.apex_legends is string && ranks.apex_legends in catalogueRankNumbers('apex_legends'))
        && (!('cs2' in ranks)
          || ranks.cs2 is string && ranks.cs2 in catalogueRankNumbers('cs2'))
        && (!('honor_of_kings' in ranks)
          || ranks.honor_of_kings is string && ranks.honor_of_kings in catalogueRankNumbers('honor_of_kings'))
        && (!('league_of_legends' in ranks)
          || ranks.league_of_legends is string && ranks.league_of_legends in catalogueRankNumbers('league_of_legends'))
        && data.get('rank', null) == rankNumber(game, chosenRank);
    }

    function validGamingPreferences(data) {
      let games = data.get('games', []);
      let game = data.get('currentGame', null);
      let mode = data.get('mode', null);
      let styles = data.get('playstyles', []);
      let communication = data.get('communication', null);
      let rank = data.get('rank', null);

      return games is list
        && games.size() <= 10
        && games.toSet().size() == games.size()
        && games.hasOnly(catalogueGames())
        && (
          (game == null && games.size() == 0)
          || (game is string && game in games)
        )
        && (
          mode == null
          || mode in ['competitive', 'casual']
        )
        && styles is list
        && styles.size() <= 3
        && styles.toSet().size() == styles.size()
        && styles.hasOnly(['chill', 'serious', 'fun'])
        && (
          communication == null
          || communication in [
            'mic_required', 'voice_optional', 'chat_only'
          ]
        )
        //accepts either existing profile using old format 
        //or using new map
        && (
          (
            'gameRanks' in data
            && validStoredGameRanks(data)
          )
          || (
            !('gameRanks' in data)
            && (
              rank == null
              || (
                game == 'valorant'
                && rank is int
                && rank >= 0
                && rank <= 7
              )
            )
          )
        );
    }

  //availability: optional public map
  //timezone: malaysia for this ver
  //preferred periods: unique permitted labels, max 4
  //weekly schedule: max 7 slots, ordered by unique weekday
  //times: mins after midnight; overnight sessions are allowed
  function validAvailabilitySlot(slot) {
    let weekday = slot.get('weekday', null);
    let start = slot.get('startMinute', null);
    let end = slot.get('endMinute', null);
    return slot is map
      && slot.keys().hasOnly(['weekday', 'startMinute', 'endMinute'])
      && weekday is int && weekday >= 1 && weekday <= 7
      && start is int && start >= 0 && start < 1440
      && end is int && end >= 0 && end <= 1440
      && start != end;
  }

  function validAvailability(data) {
    let availability = data.get('availability', {});
    let periods = availability is map
      ? availability.get('preferredTimes', [])
      : [];
    let slots = availability is map
      ? availability.get('weeklySchedule', [])
      : [];

    return !('availability' in data)
      || (
        availability is map
        && availability.keys().hasAll([
          'availableNow', 'preferredTimes', 'weeklySchedule', 'timeZone'
        ])
        && availability.keys().hasOnly([
          'availableNow', 'preferredTimes', 'weeklySchedule', 'timeZone'
        ])
        && availability.availableNow is bool
        && availability.timeZone == 'Asia/Kuala_Lumpur'
        && periods is list
        && periods.size() <= 4
        && periods.toSet().size() == periods.size()
        && periods.hasOnly([
          'Morning', 'Afternoon', 'Evening', 'Night'
        ])
        && slots is list
        && slots.size() <= 7
        && (slots.size() <= 0 || (slots[0] is map && validAvailabilitySlot(slots[0])))
        && (slots.size() <= 1 || (slots[1] is map && validAvailabilitySlot(slots[1]) && slots[0].weekday < slots[1].weekday))
        && (slots.size() <= 2 || (slots[2] is map && validAvailabilitySlot(slots[2]) && slots[1].weekday < slots[2].weekday))
        && (slots.size() <= 3 || (slots[3] is map && validAvailabilitySlot(slots[3]) && slots[2].weekday < slots[3].weekday))
        && (slots.size() <= 4 || (slots[4] is map && validAvailabilitySlot(slots[4]) && slots[3].weekday < slots[4].weekday))
        && (slots.size() <= 5 || (slots[5] is map && validAvailabilitySlot(slots[5]) && slots[4].weekday < slots[5].weekday))
        && (slots.size() <= 6 || (slots[6] is map && validAvailabilitySlot(slots[6]) && slots[5].weekday < slots[6].weekday))
      );
  }

  // Optional Supabase path, scoped to the signed-in player.
  function validPhotoPath(data) {
    let path = data.get('photoPath', null);

    return path == null || (
      path is string
      && path.size() <= 200
      && path.split('/').size() == 2
      && path.split('/')[0] == request.auth.uid
      && path.split('/')[1].matches(
        '[a-f0-9-]{36}[.](jpg|png|webp)'
      )
    );
  }
    function validPublicProfile(data) {
      return data.keys().hasAll([
          'username', 'bio', 'region', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'username', 'bio', 'region', 'createdAt', 'updatedAt',
          'sharedAge', 'ageSharedAt', 'sharedGender',
          'games', 'currentGame', 'mode', 'playstyles',
          'communication', 'rank', 'gameRanks', 'availability',
          'photoPath'
        ])
        && data.username is string
        && (
          data.username.size() == 0
          || data.username.size() >= 3
        )
        && data.username.size() <= 30
        && data.bio is string
        && data.bio.size() <= 500
        && data.region is string
        && data.region.size() <= 60
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && validSharing(data)
        && validGamingPreferences(data)
        && validAvailability(data)
        && validPhotoPath(data);
    }

    function validPrivateInfo(data) {
      return data.keys().hasAll([
          'dateOfBirth', 'gender', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'dateOfBirth', 'gender', 'createdAt', 'updatedAt'
        ])
        && (
          data.dateOfBirth == null
          || (
            data.dateOfBirth is timestamp
            && data.dateOfBirth >= timestamp.date(1900, 1, 1)
            && data.dateOfBirth <= request.time
          )
        )
        && data.gender is string
        && data.gender in [
          '', 'male', 'female', 'other', 'prefer_not_to_say'
        ]
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /player_blocks/{uid}/blocked/{target} {
      allow read: if owns(uid);
      allow create, update: if owns(uid) && uid != target
        && exists(/databases/$(database)/documents/players/$(target))
        && request.resource.data.keys().hasOnly(['createdAt'])
        && request.resource.data.createdAt == request.time;
      allow delete: if owns(uid);
    }
    match /player_reports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'reporterId', 'reporterUsername', 'playerId', 'playerUsername',
          'reasons', 'details', 'status', 'createdAt'])
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.playerId is string
        && request.resource.data.playerId != request.auth.uid
        && request.resource.data.reporterUsername is string
        && request.resource.data.playerUsername is string
        && request.resource.data.reporterUsername == get(/databases/$(database)/documents/players/$(request.auth.uid)).data.username
        && request.resource.data.playerUsername == get(/databases/$(database)/documents/players/$(request.resource.data.playerId)).data.username
        && request.resource.data.reasons is list
        && request.resource.data.reasons.size() >= 1
        && request.resource.data.reasons.size() <= 5
        && request.resource.data.reasons.toSet().size() == request.resource.data.reasons.size()
        && request.resource.data.reasons.hasOnly(['Toxic behaviour', 'Harassment', 'Inappropriate language', 'Cheating', 'Other'])
        && request.resource.data.details is string
        && request.resource.data.details.size() <= 2000
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if false;
    }
    // Direct messaging. Membership and message history are immutable to clients.
    match /chats/{chatId} {
      function member(data) {
        return signedIn() && request.auth.uid in data.userIds;
      }
      function validChat(data) {
        return data.keys().hasOnly(['type', 'userIds', 'createdAt', 'updatedAt',
            'lastMessageId', 'lastMessagePreview', 'lastSenderId', 'participantUsernames', 'lastSenderUsername'])
          && data.type == 'direct'
          && data.userIds is list && data.userIds.size() == 2
          && data.userIds[0] is string && data.userIds[1] is string
          && data.userIds[0] != data.userIds[1]
          && data.createdAt is timestamp && data.updatedAt is timestamp
          && data.lastMessageId is string && data.lastMessagePreview is string
          && data.lastSenderId is string;
      }
      function validNames(data) {
        let names = data.get('participantUsernames', null);
        return names == null || (
          names is map
          && names.keys().hasOnly(data.userIds)
          && names.keys().hasAll(data.userIds)
          && names[data.userIds[0]] == get(/databases/$(database)/documents/players/$(data.userIds[0])).data.username
          && names[data.userIds[1]] == get(/databases/$(database)/documents/players/$(data.userIds[1])).data.username);
      }
      // A missing-document get is needed to atomically open an existing/new chat.
      allow get: if signedIn() && (resource == null || member(resource.data));
      allow list: if member(resource.data);
      allow create: if member(request.resource.data)
        && unblocked(request.resource.data.userIds)
        && validChat(request.resource.data)
        && validNames(request.resource.data)
        && exists(/databases/$(database)/documents/players/$(request.resource.data.userIds[0]))
        && exists(/databases/$(database)/documents/players/$(request.resource.data.userIds[1]))
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.lastMessageId == ''
        && request.resource.data.lastMessagePreview == ''
        && request.resource.data.lastSenderId == ''
        && request.resource.data.get('lastSenderUsername', '') == '';
      allow update: if member(resource.data)
        && unblocked(request.resource.data.userIds)
        && validChat(request.resource.data)
        && validNames(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'lastMessageId', 'lastMessagePreview', 'lastSenderId', 'updatedAt', 'participantUsernames', 'lastSenderUsername'])
        && request.resource.data.updatedAt == request.time
        && request.resource.data.lastSenderId == request.auth.uid
        && (!('lastSenderUsername' in request.resource.data) || request.resource.data.lastSenderUsername == get(/databases/$(database)/documents/players/$(request.auth.uid)).data.username)
        && request.resource.data.lastMessageId != ''
        && !exists(/databases/$(database)/documents/chats/$(chatId)/messages/$(request.resource.data.lastMessageId))
        && getAfter(/databases/$(database)/documents/chats/$(chatId)/messages/$(request.resource.data.lastMessageId)).data.senderId == request.auth.uid
        && getAfter(/databases/$(database)/documents/chats/$(chatId)/messages/$(request.resource.data.lastMessageId)).data.text == request.resource.data.lastMessagePreview
        && getAfter(/databases/$(database)/documents/chats/$(chatId)/messages/$(request.resource.data.lastMessageId)).data.createdAt == request.time;
      allow delete: if false;

      match /receipts/{uid} {
        allow read: if member(get(/databases/$(database)/documents/chats/$(chatId)).data);
        allow create, update: if owns(uid)
          && member(get(/databases/$(database)/documents/chats/$(chatId)).data)
          && request.resource.data.keys().hasOnly(['messageId', 'readThrough'])
          && request.resource.data.messageId is string
          && request.resource.data.messageId.matches('[^/]+')
          && request.resource.data.readThrough is timestamp
          && request.resource.data.readThrough <= request.time
          && request.resource.data.readThrough == get(/databases/$(database)/documents/chats/$(chatId)/messages/$(request.resource.data.messageId)).data.createdAt
          && (resource == null || request.resource.data.readThrough >= resource.data.readThrough);
        allow delete: if false;
      }

      match /settings/{uid} {
        allow read: if owns(uid) && member(get(/databases/$(database)/documents/chats/$(chatId)).data);
        allow create, update: if owns(uid)
          && member(get(/databases/$(database)/documents/chats/$(chatId)).data)
          && request.resource.data.keys().hasOnly(['clearedAt'])
          && request.resource.data.clearedAt == request.time;
        allow delete: if false;
      }

      match /messages/{messageId} {
        function validMessageKind(data) {
          let users = get(/databases/$(database)/documents/chats/$(chatId)).data.userIds;
          let recipient = users[0] == request.auth.uid ? users[1] : users[0];
          let kind = data.get('type', 'text');
          return (kind == 'text'
              && data.keys().hasOnly(['senderId', 'senderUsername', 'text', 'createdAt', 'type']))
            || (kind == 'party_invite'
              && data.keys().hasOnly(['senderId', 'senderUsername', 'text', 'createdAt', 'type', 'partyId'])
              && data.partyId is string
              && data.partyId.size() > 0 && data.partyId.size() <= 1500
              && data.partyId.matches('[^/]+')
              && data.text == 'Party invitation'
              && get(/databases/$(database)/documents/parties/$(data.partyId)).data.hostId == request.auth.uid
              && get(/databases/$(database)/documents/parties/$(data.partyId)).data.status == 'open'
              && get(/databases/$(database)/documents/parties/$(data.partyId)).data.memberCount
                < get(/databases/$(database)/documents/parties/$(data.partyId)).data.maxPlayers
              && (get(/databases/$(database)/documents/parties/$(data.partyId)).data.visibility == 'public'
                || (getAfter(/databases/$(database)/documents/parties/$(data.partyId)/invitations/$(recipient)).data.hostId == request.auth.uid
                  && getAfter(/databases/$(database)/documents/parties/$(data.partyId)/invitations/$(recipient)).data.chatId == chatId
                  && getAfter(/databases/$(database)/documents/parties/$(data.partyId)/invitations/$(recipient)).data.messageId == messageId)));
        }
        function parent() {
          return get(/databases/$(database)/documents/chats/$(chatId)).data;
        }
        allow read: if member(parent());
        allow create: if member(parent())
          && unblocked(parent().userIds)
          && validMessageKind(request.resource.data)
          && request.resource.data.senderId == request.auth.uid
          && (!('senderUsername' in request.resource.data) || request.resource.data.senderUsername == get(/databases/$(database)/documents/players/$(request.auth.uid)).data.username)
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000
          && request.resource.data.text.matches('[\\s\\S]*[^\\s][\\s\\S]*')
          && request.resource.data.createdAt == request.time
          && getAfter(/databases/$(database)/documents/chats/$(chatId)).data.lastMessageId == messageId
          && getAfter(/databases/$(database)/documents/chats/$(chatId)).data.updatedAt == request.time;
        allow update, delete: if false;
      }
    }

    function validPartyDetails(data) {
      return data.keys().hasAll([
          'title', 'hostId', 'gameId', 'region', 'mode', 'visibility',
          'maxPlayers', 'memberCount', 'minRank', 'maxRank', 'playstyles',
          'communication', 'minimumRating', 'description', 'status',
          'createdAt', 'updatedAt', 'startedAt', 'completedAt'
        ])
        && data.keys().hasOnly([
          'title', 'hostId', 'gameId', 'region', 'mode', 'visibility',
          'maxPlayers', 'memberCount', 'minRank', 'maxRank', 'playstyles',
          'communication', 'minimumRating', 'description', 'status',
          'createdAt', 'updatedAt', 'startedAt', 'completedAt', 'lastRemovedMemberId'
        ])
        && data.hostId == request.auth.uid
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 60
        && data.title.matches('.*\\S.*')
        && data.gameId in catalogueGames()
        && data.region in ['asia', 'europe', 'north_america', 'south_america', 'africa', 'oceania']
        && data.mode in ['competitive', 'casual']
        && data.visibility in ['public', 'private']
        && data.maxPlayers is int && data.maxPlayers >= 2 && data.maxPlayers <= 10
        && data.minimumRating is number && data.minimumRating >= 0 && data.minimumRating <= 5
        && data.playstyles is list && data.playstyles.size() >= 1 && data.playstyles.size() <= 3
        && data.playstyles.hasOnly(['chill', 'serious', 'fun'])
        && data.playstyles.toSet().size() == data.playstyles.size()
        && data.communication in ['mic_required', 'voice_optional', 'chat_only']
        && data.description is string && data.description.size() <= 500
        && (
          (data.minRank == null && data.maxRank == null)
          || (data.minRank is int && data.maxRank is int
              && data.minRank >= 0 && data.maxRank < catalogueRankCount(data.gameId) && data.minRank <= data.maxRank)
        )
        ;
    }

    function validNewParty(data) {
      return validPartyDetails(data)
        && !('lastRemovedMemberId' in data)
        && data.memberCount == 1 && data.status == 'open'
        && data.createdAt == request.time && data.updatedAt == request.time
        && data.startedAt == null && data.completedAt == null;
    }

    function validHostMembership(data) {
      return data.keys().hasAll(['role', 'joinedAt', 'leftAt'])
        && data.keys().hasOnly(['role', 'joinedAt', 'leftAt'])
        && data.role == 'host' && data.joinedAt == request.time && data.leftAt == null;
    }

    // One counter per host serializes creation across devices.
    // Existing hosts may initially have >1; closing each session reduces it.
    match /party_host_slots/{uid} {
      allow get: if owns(uid);
      allow list, delete: if false;
      allow create, update: if owns(uid)
        && request.resource.data.keys().hasAll(['activeCount', 'lastPartyId', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['activeCount', 'lastPartyId', 'updatedAt'])
        && request.resource.data.activeCount is int
        && request.resource.data.activeCount >= 0
        && request.resource.data.lastPartyId is string
        && request.resource.data.updatedAt == request.time
        && (
          (request.resource.data.activeCount == 1
            && (resource == null || resource.data.activeCount == 0)
            && !exists(/databases/$(database)/documents/parties/$(request.resource.data.lastPartyId))
            && getAfter(/databases/$(database)/documents/parties/$(request.resource.data.lastPartyId)).data.hostId == uid
            && getAfter(/databases/$(database)/documents/parties/$(request.resource.data.lastPartyId)).data.status == 'open')
          || (resource != null && resource.data.activeCount > 0
            && request.resource.data.activeCount == resource.data.activeCount - 1
            && get(/databases/$(database)/documents/parties/$(request.resource.data.lastPartyId)).data.hostId == uid
            && get(/databases/$(database)/documents/parties/$(request.resource.data.lastPartyId)).data.status == 'open'
            && getAfter(/databases/$(database)/documents/parties/$(request.resource.data.lastPartyId)).data.status == 'closed')
        );
    }

    match /party_memberships/{uid} {
      allow get: if owns(uid);
      allow list: if false;
      function canReplace() {
        return resource == null
          || get(/databases/$(database)/documents/parties/$(resource.data.partyId)).data.status != 'open'
          || get(/databases/$(database)/documents/parties/$(resource.data.partyId)/members/$(uid)).data.leftAt != null
          || getAfter(/databases/$(database)/documents/parties/$(resource.data.partyId)/members/$(uid)).data.leftAt != null;
      }
      allow create, update: if owns(uid) && canReplace()
        && request.resource.data.keys().hasAll(['partyId', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['partyId', 'updatedAt'])
        && request.resource.data.partyId is string
        && request.resource.data.updatedAt == request.time
        && getAfter(/databases/$(database)/documents/parties/$(request.resource.data.partyId)/members/$(uid)).data.role == 'member'
        && getAfter(/databases/$(database)/documents/parties/$(request.resource.data.partyId)/members/$(uid)).data.leftAt == null
        && getAfter(/databases/$(database)/documents/parties/$(request.resource.data.partyId)/members/$(uid)).data.joinedAt == request.time
        && getAfter(/databases/$(database)/documents/parties/$(request.resource.data.partyId)).data.memberCount
          == get(/databases/$(database)/documents/parties/$(request.resource.data.partyId)).data.memberCount + 1;
      allow delete: if owns(uid) && (
        get(/databases/$(database)/documents/parties/$(resource.data.partyId)).data.status != 'open'
        || getAfter(/databases/$(database)/documents/parties/$(resource.data.partyId)/members/$(uid)).data.leftAt == request.time);
    }

    function noActiveJoinedParty(uid) {
      let pointer = /databases/$(database)/documents/party_memberships/$(uid);
      return !existsAfter(pointer)
        || getAfter(/databases/$(database)/documents/parties/$(getAfter(pointer).data.partyId)).data.status != 'open'
        || getAfter(/databases/$(database)/documents/parties/$(getAfter(pointer).data.partyId)/members/$(uid)).data.leftAt != null;
    }

    function hasPartyHistory(partyId) {
      return signedIn()
        && exists(/databases/$(database)/documents/players/$(request.auth.uid)/party_history/$(partyId))
        && exists(/databases/$(database)/documents/parties/$(partyId)/members/$(request.auth.uid));
    }

    match /parties/{partyId} {
      allow read: if signedIn() && (
        (resource.data.visibility == 'public' && resource.data.status == 'open')
        || resource.data.hostId == request.auth.uid
        || activeMember(request.auth.uid)
        || hasPartyHistory(partyId)
        || (resource.data.status == 'open'
          && exists(/databases/$(database)/documents/parties/$(partyId)/invitations/$(request.auth.uid)))
      );
      // The host membership must be included in the same atomic write.
      allow create: if signedIn() && validNewParty(request.resource.data)
        && noActiveJoinedParty(request.auth.uid)
        && (!exists(/databases/$(database)/documents/party_host_slots/$(request.auth.uid))
          || get(/databases/$(database)/documents/party_host_slots/$(request.auth.uid)).data.activeCount == 0)
        && getAfter(/databases/$(database)/documents/party_host_slots/$(request.auth.uid)).data.activeCount == 1
        && getAfter(/databases/$(database)/documents/party_host_slots/$(request.auth.uid)).data.lastPartyId == partyId
        && validHostMembership(getAfter(
          /databases/$(database)/documents/parties/$(partyId)/members/$(request.auth.uid)
        ).data);
      function activeMember(uid) {
        return exists(/databases/$(database)/documents/parties/$(partyId)/members/$(uid))
          && get(/databases/$(database)/documents/parties/$(partyId)/members/$(uid)).data.leftAt == null;
      }
      function canJoin() {
        let member = /databases/$(database)/documents/parties/$(partyId)/members/$(request.auth.uid);
        let joined = getAfter(member).data;
        return resource.data.status == 'open' && request.auth.uid != resource.data.hostId
          && (!existsAfter(/databases/$(database)/documents/party_host_slots/$(request.auth.uid))
            || getAfter(/databases/$(database)/documents/party_host_slots/$(request.auth.uid)).data.activeCount == 0)
          && resource.data.memberCount < resource.data.maxPlayers
          && (resource.data.visibility == 'public'
            || exists(/databases/$(database)/documents/parties/$(partyId)/invitations/$(request.auth.uid)))
          && (!exists(member) || (get(member).data.leftAt != null
            && (get(member).data.get('removedBy', null) == null
              || (exists(/databases/$(database)/documents/parties/$(partyId)/invitations/$(request.auth.uid))
                && get(/databases/$(database)/documents/parties/$(partyId)/invitations/$(request.auth.uid)).data.createdAt > get(member).data.leftAt))))
          && unblocked([resource.data.hostId, request.auth.uid])
          && joined.keys().hasAll(['role', 'joinedAt', 'leftAt'])
          && joined.keys().hasOnly(['role', 'joinedAt', 'leftAt'])
          && joined.role == 'member' && joined.joinedAt == request.time && joined.leftAt == null
          && getAfter(/databases/$(database)/documents/party_memberships/$(request.auth.uid)).data.partyId == partyId;
      }
      function leftSelf() {
        return activeMember(request.auth.uid)
          && getAfter(/databases/$(database)/documents/parties/$(partyId)/members/$(request.auth.uid)).data.leftAt == request.time;
      }
      allow update: if signedIn() && resource.data.status == 'open'
        && request.resource.data.updatedAt == request.time
        && (
          (resource.data.hostId == request.auth.uid
            && validPartyDetails(request.resource.data)
            && request.resource.data.maxPlayers >= resource.data.memberCount
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'title', 'gameId', 'region', 'mode', 'visibility', 'maxPlayers',
              'minRank', 'maxRank', 'playstyles', 'communication',
              'minimumRating', 'description', 'updatedAt']))
          || (resource.data.hostId == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberCount', 'updatedAt', 'lastRemovedMemberId'])
            && request.resource.data.lastRemovedMemberId is string
            && request.resource.data.lastRemovedMemberId != resource.data.hostId
            && resource.data.memberCount > 1
            && request.resource.data.memberCount == resource.data.memberCount - 1
            && get(/databases/$(database)/documents/parties/$(partyId)/members/$(request.resource.data.lastRemovedMemberId)).data.role == 'member'
            && get(/databases/$(database)/documents/parties/$(partyId)/members/$(request.resource.data.lastRemovedMemberId)).data.leftAt == null
            && getAfter(/databases/$(database)/documents/parties/$(partyId)/members/$(request.resource.data.lastRemovedMemberId)).data.leftAt == request.time
            && getAfter(/databases/$(database)/documents/parties/$(partyId)/members/$(request.resource.data.lastRemovedMemberId)).data.removedBy == request.auth.uid)
          || (canJoin()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberCount', 'updatedAt'])
            && request.resource.data.memberCount == resource.data.memberCount + 1)
          || (leftSelf()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'memberCount', 'updatedAt'])
            && (resource.data.hostId == request.auth.uid
              ? request.resource.data.status == 'closed' && request.resource.data.memberCount == 0
                && getAfter(/databases/$(database)/documents/party_host_slots/$(request.auth.uid)).data.activeCount
                  == get(/databases/$(database)/documents/party_host_slots/$(request.auth.uid)).data.activeCount - 1
                && getAfter(/databases/$(database)/documents/party_host_slots/$(request.auth.uid)).data.lastPartyId == partyId
              : request.resource.data.status == 'open'
                && resource.data.memberCount > 1
                && request.resource.data.memberCount == resource.data.memberCount - 1))
        );
      allow delete: if false;

      match /invitations/{uid} {
        function partyData() {
          return get(/databases/$(database)/documents/parties/$(partyId)).data;
        }
        function validInvite(data) {
          let chat = getAfter(/databases/$(database)/documents/chats/$(data.chatId)).data;
          let message = getAfter(/databases/$(database)/documents/chats/$(data.chatId)/messages/$(data.messageId)).data;
          return data.keys().hasAll(['hostId', 'chatId', 'messageId', 'createdAt'])
            && data.keys().hasOnly(['hostId', 'chatId', 'messageId', 'createdAt'])
            && data.hostId == request.auth.uid && uid != request.auth.uid
            && partyData().hostId == request.auth.uid && partyData().status == 'open'
            && partyData().memberCount < partyData().maxPlayers
            && exists(/databases/$(database)/documents/players/$(uid))
            && (!exists(/databases/$(database)/documents/parties/$(partyId)/members/$(uid))
              || get(/databases/$(database)/documents/parties/$(partyId)/members/$(uid)).data.leftAt != null)
            && data.createdAt == request.time
            && chat.type == 'direct' && chat.userIds.size() == 2
            && uid in chat.userIds && request.auth.uid in chat.userIds
            && message.type == 'party_invite' && message.partyId == partyId
            && message.senderId == request.auth.uid && message.createdAt == request.time;
        }
        allow get: if signedIn() && (owns(uid) || partyData().hostId == request.auth.uid);
        allow list: if signedIn() && partyData().hostId == request.auth.uid;
        allow create, update: if signedIn() && validInvite(request.resource.data);
        allow delete: if false;
      }

      match /members/{uid} {
        function parent() { return get(/databases/$(database)/documents/parties/$(partyId)).data; }
        function joining() {
          let data = request.resource.data;
          return uid != parent().hostId && parent().status == 'open'
            && parent().memberCount < parent().maxPlayers
            && (parent().visibility == 'public' || exists(/databases/$(database)/documents/parties/$(partyId)/invitations/$(uid)))
            && data.keys().hasAll(['role', 'joinedAt', 'leftAt']) && data.keys().hasOnly(['role', 'joinedAt', 'leftAt'])
            && data.role == 'member' && data.joinedAt == request.time && data.leftAt == null
            && getAfter(/databases/$(database)/documents/parties/$(partyId)).data.memberCount == parent().memberCount + 1
            && getAfter(/databases/$(database)/documents/party_memberships/$(uid)).data.partyId == partyId;
        }
        function canPreviewRoster() {
          return parent().status == 'open' && (parent().visibility == 'public'
            || activeMember(request.auth.uid)
            || exists(/databases/$(database)/documents/parties/$(partyId)/invitations/$(request.auth.uid)));
        }
        allow get: if signedIn() && (owns(uid) || parent().hostId == request.auth.uid || canPreviewRoster() || hasPartyHistory(partyId));
        allow list: if signedIn() && (parent().hostId == request.auth.uid || canPreviewRoster() || hasPartyHistory(partyId));
        allow create: if owns(uid) && (
          (!exists(/databases/$(database)/documents/parties/$(partyId))
            && getAfter(/databases/$(database)/documents/parties/$(partyId)).data.hostId == uid
            && validHostMembership(request.resource.data)) || joining());
        allow update: if owns(uid) && (
          (resource.data.leftAt != null && joining())
          || (resource.data.leftAt == null
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['leftAt'])
            && request.resource.data.leftAt == request.time
            && parent().status == 'open'
            && (parent().hostId == uid
              ? getAfter(/databases/$(database)/documents/parties/$(partyId)).data.status == 'closed'
                && getAfter(/databases/$(database)/documents/parties/$(partyId)).data.memberCount == 0
              : getAfter(/databases/$(database)/documents/parties/$(partyId)).data.status == 'open'
                && getAfter(/databases/$(database)/documents/parties/$(partyId)).data.memberCount == parent().memberCount - 1)));
        allow update: if signedIn() && parent().hostId == request.auth.uid && uid != request.auth.uid
          && parent().status == 'open' && resource.data.role == 'member' && resource.data.leftAt == null
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['leftAt', 'removedBy'])
          && request.resource.data.leftAt == request.time && request.resource.data.removedBy == request.auth.uid
          && getAfter(/databases/$(database)/documents/parties/$(partyId)).data.lastRemovedMemberId == uid
          && getAfter(/databases/$(database)/documents/parties/$(partyId)).data.memberCount == parent().memberCount - 1;
        allow delete: if false;
      }
    }
    // Each player can list only their own participation history.
    match /players/{uid}/party_history/{partyId} {
      allow read: if owns(uid);
      allow create, update: if owns(uid)
        && request.resource.data.keys().hasAll(['title', 'gameId', 'mode', 'joinedAt'])
        && request.resource.data.keys().hasOnly(['title', 'gameId', 'mode', 'joinedAt'])
        && request.resource.data.joinedAt == request.time
        && getAfter(/databases/$(database)/documents/parties/$(partyId)/members/$(uid)).data.joinedAt == request.time
        && getAfter(/databases/$(database)/documents/parties/$(partyId)/members/$(uid)).data.leftAt == null
        && getAfter(/databases/$(database)/documents/parties/$(partyId)).data.status == 'open'
        && request.resource.data.title == getAfter(/databases/$(database)/documents/parties/$(partyId)).data.title
        && request.resource.data.gameId == getAfter(/databases/$(database)/documents/parties/$(partyId)).data.gameId
        && request.resource.data.mode == getAfter(/databases/$(database)/documents/parties/$(partyId)).data.mode;
      allow delete: if false;
    }

    match /players/{uid} {
      allow read: if signedIn();

      allow create: if owns(uid)
        && validPublicProfile(request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      function validProfileUpdate() {
        let data = request.resource.data;
        let changed = data.diff(resource.data).affectedKeys();

        return owns(uid)
          && data.updatedAt == request.time
          && (
            (
              changed.hasOnly(['photoPath', 'updatedAt'])
              && validPhotoPath(data)
            )
            || (
              changed.hasOnly(['availability', 'updatedAt'])
              && validAvailability(data)
            )
            || (
              changed.hasOnly([
                'username', 'bio', 'region', 'updatedAt',
                'sharedAge', 'ageSharedAt', 'sharedGender',
                'games', 'currentGame', 'mode', 'playstyles',
                'communication', 'rank', 'gameRanks',
                'availability', 'photoPath'
              ])
              && validPublicProfile(data)
              && (
                !changed.hasAny(['availability'])
                || validAvailability(data)
              )
            )
          );
      }
      allow update: if validProfileUpdate();

      allow delete: if false;
    }

    match /player_private/{uid} {
      allow read: if owns(uid);

      allow create: if owns(uid)
        && validPrivateInfo(request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if owns(uid)
        && validPrivateInfo(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['dateOfBirth', 'gender', 'updatedAt'])
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;
    }
  }
}
