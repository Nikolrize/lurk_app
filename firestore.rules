rules_version = '2';

// players/{uid}:
// username, bio, region: required strings.
// createdAt: immutable timestamp; updatedAt: server timestamp.
//
// player_private/{uid}:
// dateOfBirth: required nullable timestamp.
// gender: required string from the allowed values.
// createdAt: immutable timestamp; updatedAt: server timestamp.
//
// document IDs are firebase auth UIDs
// unmactched paths are denied


// optional public sharing
// sharedAge: nullable integer, 0 - 150 
// ageSharedAt: nullable timestamp, required with a shared age
//sharedGender : nullable male/female/other
//full birth date remains in player_private

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function owns(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function unblocked(users) {
      return !exists(/databases/$(database)/documents/player_blocks/$(users[0])/users/$(users[1]))
        && !exists(/databases/$(database)/documents/player_blocks/$(users[1])/users/$(users[0]));
    }

    match /player_blocks/{uid}/users/{otherUid} {
      allow get: if signedIn() && request.auth.uid in [uid, otherUid];
      allow list: if owns(uid);
      allow create: if owns(uid) && uid != otherUid
        && request.resource.data.keys().hasOnly(['createdAt'])
        && request.resource.data.createdAt == request.time
        && exists(/databases/$(database)/documents/players/$(otherUid));
      allow delete: if owns(uid);
      allow update: if false;
    }

    function validSharing(data) {
      let age = data.get('sharedAge', null);
      let sharedAt = data.get('ageSharedAt', null);
      let gender = data.get('sharedGender', null);

      return (
        (age == null && sharedAt == null)
        || (
          age is int
          && age >= 0
          && age <= 150
          && sharedAt is timestamp
          && sharedAt <= request.time
        )
      )
      && (
        gender == null
        || gender in ['male', 'female', 'other']
      );
    }


    // Keep these server-side bounds aligned with GameCatalog.
    function catalogueRankCount(game) {
      return {'valorant': 9, 'mobile_legends': 10, 'fortnite': 0}.get(game, 0);
    }
    //rank number same as game's catalogue position
    function rankNumber(game, rankId) {
      let valorant = {
        'iron': 0,
        'bronze': 1,
        'silver': 2,
        'gold': 3,
        'platinum': 4,
        'diamond': 5,
        'ascendant': 6,
        'immortal': 7,
        'radiant': 8
      };

      let mobileLegends = {
        'warrior': 0,
        'elite': 1,
        'master': 2,
        'grandmaster': 3,
        'epic': 4,
        'legend': 5,
        'mythic': 6,
        'mythical_honor': 7,
        'mythical_glory': 8,
        'mythical_immortal': 9
      };

      return rankId == null ? null: (
          game == 'valorant' ? valorant.get(rankId, null) : (
              game == 'mobile_legends' ? mobileLegends.get(rankId, null) : null
            )
        );
    }

    //gameRanks - optional public map
    // only selected, supported ranked games have entries
    //each entry must contain valid rank ID
    function validStoredGameRanks(data) {
      let ranks = data.get('gameRanks', {});
      let games = data.get('games', []);
      let game = data.get('currentGame', null);
      let chosenRank = ranks is map && game is string
        ? ranks.get(game, null)
        : null;

      return ranks is map
        && ranks.keys().size() <= 2
        && ranks.keys().hasOnly(['valorant', 'mobile_legends'])
        && ranks.keys().hasOnly(games)
        && (
          !('valorant' in ranks)
          || ranks.valorant in [
            'iron', 'bronze', 'silver', 'gold', 'platinum',
            'diamond', 'ascendant', 'immortal', 'radiant'
          ]
        )
        && (
          !('mobile_legends' in ranks)
          || ranks.mobile_legends in [
            'warrior', 'elite', 'master', 'grandmaster',
            'epic', 'legend', 'mythic', 'mythical_honor',
            'mythical_glory', 'mythical_immortal'
          ]
        )
        && data.get('rank', null) == rankNumber(game, chosenRank);
    }

    function validGamingPreferences(data) {
      let games = data.get('games', []);
      let game = data.get('currentGame', null);
      let mode = data.get('mode', null);
      let styles = data.get('playstyles', []);
      let communication = data.get('communication', null);
      let rank = data.get('rank', null);

      return games is list
        && games.size() <= 3
        && games.toSet().size() == games.size()
        && games.hasOnly([
          'valorant', 'mobile_legends', 'fortnite'
        ])
        && (
          (game == null && games.size() == 0)
          || (game is string && game in games)
        )
        && (
          mode == null
          || mode in ['competitive', 'casual']
        )
        && styles is list
        && styles.size() <= 3
        && styles.toSet().size() == styles.size()
        && styles.hasOnly(['chill', 'serious', 'fun'])
        && (
          communication == null
          || communication in [
            'mic_required', 'voice_optional', 'chat_only'
          ]
        )
        //accepts either existing profile using old format 
        //or using new map
        && (
          (
            'gameRanks' in data
            && validStoredGameRanks(data)
          )
          || (
            !('gameRanks' in data)
            && (
              rank == null
              || (
                game == 'valorant'
                && rank is int
                && rank >= 0
                && rank <= 7
              )
            )
          )
        );
    }

    function validPublicProfile(data) {
      return data.keys().hasAll([
          'username', 'bio', 'region', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'username', 'bio', 'region', 'createdAt', 'updatedAt',
          'sharedAge', 'ageSharedAt', 'sharedGender',
          'games', 'currentGame', 'mode', 'playstyles',
          'communication', 'rank', 'gameRanks', 'gameRanks'
        ])
        && data.username is string
        && (
          data.username.size() == 0
          || data.username.size() >= 3
        )
        && data.username.size() <= 30
        && data.bio is string
        && data.bio.size() <= 500
        && data.region is string
        && data.region.size() <= 60
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && validSharing(data)
        && validGamingPreferences(data);
    }

    function validPrivateInfo(data) {
      return data.keys().hasAll([
          'dateOfBirth', 'gender', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'dateOfBirth', 'gender', 'createdAt', 'updatedAt'
        ])
        && (
          data.dateOfBirth == null
          || (
            data.dateOfBirth is timestamp
            && data.dateOfBirth >= timestamp.date(1900, 1, 1)
            && data.dateOfBirth <= request.time
          )
        )
        && data.gender is string
        && data.gender in [
          '', 'male', 'female', 'other', 'prefer_not_to_say'
        ]
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Direct messaging. Membership and message history are immutable to clients.
    match /chats/{chatId} {
      function member(data) {
        return signedIn() && request.auth.uid in data.userIds;
      }
      function validChat(data) {
        return data.keys().hasOnly(['type', 'userIds', 'createdAt', 'updatedAt',
            'lastMessageId', 'lastMessagePreview', 'lastSenderId'])
          && data.type == 'direct'
          && data.userIds is list && data.userIds.size() == 2
          && data.userIds[0] is string && data.userIds[1] is string
          && data.userIds[0] != data.userIds[1]
          && data.createdAt is timestamp && data.updatedAt is timestamp
          && data.lastMessageId is string && data.lastMessagePreview is string
          && data.lastSenderId is string;
      }
      // A missing-document get is needed to atomically open an existing/new chat.
      allow get: if signedIn() && (resource == null || member(resource.data));
      allow list: if member(resource.data);
      allow create: if member(request.resource.data)
        && validChat(request.resource.data)
        && unblocked(request.resource.data.userIds)
        && exists(/databases/$(database)/documents/players/$(request.resource.data.userIds[0]))
        && exists(/databases/$(database)/documents/players/$(request.resource.data.userIds[1]))
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.lastMessageId == ''
        && request.resource.data.lastMessagePreview == ''
        && request.resource.data.lastSenderId == '';
      allow update: if member(resource.data)
        && unblocked(resource.data.userIds)
        && validChat(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'lastMessageId', 'lastMessagePreview', 'lastSenderId', 'updatedAt'])
        && request.resource.data.updatedAt == request.time
        && request.resource.data.lastSenderId == request.auth.uid
        && request.resource.data.lastMessageId != ''
        && !exists(/databases/$(database)/documents/chats/$(chatId)/messages/$(request.resource.data.lastMessageId))
        && getAfter(/databases/$(database)/documents/chats/$(chatId)/messages/$(request.resource.data.lastMessageId)).data.senderId == request.auth.uid
        && getAfter(/databases/$(database)/documents/chats/$(chatId)/messages/$(request.resource.data.lastMessageId)).data.text == request.resource.data.lastMessagePreview
        && getAfter(/databases/$(database)/documents/chats/$(chatId)/messages/$(request.resource.data.lastMessageId)).data.createdAt == request.time;
      allow delete: if false;

      match /settings/{uid} {
        allow read: if owns(uid) && member(get(/databases/$(database)/documents/chats/$(chatId)).data);
        allow create, update: if owns(uid)
          && member(get(/databases/$(database)/documents/chats/$(chatId)).data)
          && request.resource.data.keys().hasOnly(['clearedAt'])
          && request.resource.data.clearedAt == request.time;
        allow delete: if false;
      }

      match /messages/{messageId} {
        function validMessageKind(data) {
          let kind = data.get('type', 'text');
          return (kind == 'text'
              && data.keys().hasOnly(['senderId', 'text', 'createdAt', 'type']))
            || (kind == 'party_invite'
              && data.keys().hasOnly(['senderId', 'text', 'createdAt', 'type', 'partyId'])
              && data.partyId is string
              && data.partyId.size() > 0 && data.partyId.size() <= 1500
              && data.partyId.matches('[^/]+')
              && data.text == 'Party invitation'
              && get(/databases/$(database)/documents/parties/$(data.partyId)).data.hostId == request.auth.uid
              && get(/databases/$(database)/documents/parties/$(data.partyId)).data.visibility == 'public'
              && get(/databases/$(database)/documents/parties/$(data.partyId)).data.status == 'open');
        }
        function parent() {
          return get(/databases/$(database)/documents/chats/$(chatId)).data;
        }
        allow read: if member(parent());
        allow create: if member(parent())
          && unblocked(parent().userIds)
          && validMessageKind(request.resource.data)
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000
          && request.resource.data.text.matches('[\\s\\S]*[^\\s][\\s\\S]*')
          && request.resource.data.createdAt == request.time
          && getAfter(/databases/$(database)/documents/chats/$(chatId)).data.lastMessageId == messageId
          && getAfter(/databases/$(database)/documents/chats/$(chatId)).data.updatedAt == request.time;
        allow update, delete: if false;
      }
    }

    function validNewParty(data) {
      return data.keys().hasAll([
          'title', 'hostId', 'gameId', 'region', 'mode', 'visibility',
          'maxPlayers', 'memberCount', 'minRank', 'maxRank', 'playstyles',
          'communication', 'minimumRating', 'description', 'status',
          'createdAt', 'updatedAt', 'startedAt', 'completedAt'
        ])
        && data.keys().hasOnly([
          'title', 'hostId', 'gameId', 'region', 'mode', 'visibility',
          'maxPlayers', 'memberCount', 'minRank', 'maxRank', 'playstyles',
          'communication', 'minimumRating', 'description', 'status',
          'createdAt', 'updatedAt', 'startedAt', 'completedAt'
        ])
        && data.hostId == request.auth.uid
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 60
        && data.title.matches('.*\\S.*')
        && data.gameId in ['valorant', 'mobile_legends', 'fortnite']
        && data.region in ['asia', 'europe', 'north_america', 'south_america', 'africa', 'oceania']
        && data.mode in ['competitive', 'casual']
        && data.visibility in ['public', 'private']
        && data.maxPlayers is int && data.maxPlayers >= 2 && data.maxPlayers <= 10
        && data.memberCount == 1 && data.status == 'open'
        && data.minimumRating is number && data.minimumRating >= 0 && data.minimumRating <= 5
        && data.playstyles is list && data.playstyles.size() >= 1 && data.playstyles.size() <= 3
        && data.playstyles.hasOnly(['chill', 'serious', 'fun'])
        && data.playstyles.toSet().size() == data.playstyles.size()
        && data.communication in ['mic_required', 'voice_optional', 'chat_only']
        && data.description is string && data.description.size() <= 500
        && (
          (data.minRank == null && data.maxRank == null)
          || (data.minRank is int && data.maxRank is int
              && data.minRank >= 0 && data.maxRank < catalogueRankCount(data.gameId) && data.minRank <= data.maxRank)
        )
        && data.createdAt == request.time && data.updatedAt == request.time
        && data.startedAt == null && data.completedAt == null;
    }

    function validHostMembership(data) {
      return data.keys().hasAll(['role', 'joinedAt', 'leftAt'])
        && data.keys().hasOnly(['role', 'joinedAt', 'leftAt'])
        && data.role == 'host' && data.joinedAt == request.time && data.leftAt == null;
    }

    match /parties/{partyId} {
      allow read: if signedIn() && (
        (resource.data.visibility == 'public' && resource.data.status == 'open')
        || resource.data.hostId == request.auth.uid
      );
      // The host membership must be included in the same atomic write.
      allow create: if signedIn() && validNewParty(request.resource.data)
        && validHostMembership(getAfter(
          /databases/$(database)/documents/parties/$(partyId)/members/$(request.auth.uid)
        ).data);
      allow update, delete: if false;

      match /members/{uid} {
        allow read: if signedIn() && get(
          /databases/$(database)/documents/parties/$(partyId)
        ).data.hostId == request.auth.uid;
        allow create: if owns(uid)
          && !exists(/databases/$(database)/documents/parties/$(partyId))
          && getAfter(/databases/$(database)/documents/parties/$(partyId)).data.hostId == uid
          && validHostMembership(request.resource.data);
        allow update, delete: if false;
      }
    }
    match /players/{uid} {
      allow read: if signedIn();

      allow create: if owns(uid)
        && validPublicProfile(request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if owns(uid)
        && validPublicProfile(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly([
          'username', 'bio', 'region', 'updatedAt',
          'sharedAge', 'ageSharedAt', 'sharedGender',
          'games', 'currentGame', 'mode', 'playstyles',
          'communication', 'rank', 'gameRanks'
        ])
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;
    }

    match /player_private/{uid} {
      allow read: if owns(uid);

      allow create: if owns(uid)
        && validPrivateInfo(request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if owns(uid)
        && validPrivateInfo(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['dateOfBirth', 'gender', 'updatedAt'])
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;
    }
  }
}
